#!/bin/sh
# OpenSCAD for agents' openscad MCP server (OPENSCAD_PATH in .mcp.json, .codex/config.toml and
# opencode.json): runs the OpenSCAD image the toolchain in docker/ is built on, so the MCP renders
# with the same snapshot as the build and nothing is installed or compiled. Docker pulls the image
# on first use. It sees files the way a local OpenSCAD would: /tmp, $HOME and the repo are mounted
# at their own paths, and the container runs as you.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd -P)
ROOT=$(cd "$HERE/.." && pwd -P)
IMAGE=$(sed -n 's/^FROM \([^ ]*\).*/\1/p' "$HERE/docker/Dockerfile" | head -n 1)
set -- "$IMAGE" timeout "${MCP_RENDER_TIMEOUT:-300}" openscad "$@"
case "$ROOT/" in
    "$HOME"/*) ;;
    *) set -- -v "$ROOT:$ROOT" "$@" ;;
esac
# timeout: the MCP stops a slow render by killing this script, which would leave the container running
exec docker run --rm --init --cpus "${CPUS:-3}" --user "$(id -u):$(id -g)" -e HOME="$HOME" \
    -e OPENSCADPATH="${OPENSCADPATH:-}" -v /tmp:/tmp -v "$HOME:$HOME" -w "$(pwd -P)" "$@"
